{
	"name": "bitsy-together",
	"version": "8.12.0",
	"description": "make tiny games, worlds, and stories",
	"author": "@jatazak, @ledoux, and the bitsy contributors",
	"type": "module",
	"devDependencies": {
		"@automerge/automerge-repo-sync-server": "^0.2.8",
		"concurrently": "^9.2.4",
		"http-server": "^14.1.1",
		"selenium-webdriver": "^4.35.0",
		"ssh2": "^1.11.0"
	},
	"scripts": {
		"setup-env": "node -e \"const fs=require('fs'); if(!fs.existsSync('editor/env.js')) fs.copyFileSync('editor/env.default.js', 'env.js');\"",
    	"prestart": "npm run setup-env",
		"client": "npx http-server ./editor/",
		"server": "node ./automerge-repo-sync-server/src/index.js",
		"start": "concurrently \"npm run client\" \"npm run server\" ",
		"test": "node ./dev/test_simultaneous_edits.cjs"
	},
	"dependencies": {
		"jsondiffpatch": "^0.7.6"
	}
}
